  },
  "scripts": {
    "update": "npm outdated -p | cut -d ':' -f 4 | xargs npm install",
    "migrate": "node --experimental-strip-types src/bin/migrate.ts",
    "sync:prod": "node scripts/sync-tournaments.mjs",
    "compile": "export NODE_ENV=dev && nodemon --exec node --experimental-strip-types src/bin/start.ts",
    "open": "concurrently \"npm run compile\" \"sleep 3 && open http://localhost:3000/\"",
    "test": "node --experimental-strip-types src/bin/run-tests.ts",
    "dev": "npm run test && (lsof -ti tcp:3000 | xargs kill 2>/dev/null || true) && sleep 1 && (lsof -ti tcp:3000 | xargs kill -9 2>/dev/null || true) && (rm -f .data/badmr.sqlite3 || true) && npm run migrate && export NODE_ENV=dev && npm run open | tee -a .log/dev.log",
    "prod": "npm install && npm run migrate && export NODE_ENV=prod && node src/bin/start.ts | tee -a .log/prod.log",
    "release": "npm run test && rsync --info=progress2 --ignore-times --delete --delete-after --recursive --exclude-from='/Users/r/Projects.localized/badmr/.gitignore' /Users/r/Projects.localized/badmr box:~/ && rsync --info=progress2 --ignore-times --delete --delete-after --recursive /Users/r/Projects.localized/badmr/migrations/ box:~/badmr/migrations/ && rsync --info=progress2 --ignore-times --delete --delete-after --recursive /Users/r/Projects.localized/badmr/src/repositories/ box:~/badmr/src/repositories/ && rsync --info=progress2 --ignore-times --delete --delete-after --recursive /Users/r/Projects.localized/badmr/.data/badm4u-cookies.txt box:~/badmr/.data/ && ssh box 'sudo /home/r/badmr/etc/scripts/release.sh'",
    "typecheck": "tsc --noEmit"
  },
  "author": {
    "name": "Vasilevich Roman",
    "email": "vasilevich@gmail.com",
    "url": "https://t.me/vasilevichr"
  },
  "license": "MIT",
  "description": "Бадминтон и ром"
}
