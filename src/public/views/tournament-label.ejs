<%# Компактная подпись турнира: «#5 НЛ 01.11.26» (id + инициалы типа +
    числовая дата dd.mm.yy без города — номер турнира однозначно его
    определяет). Параметры: id (number), type_name (string), city (string,
    не используется, оставлен для совместимости вызовов), date (ISO-строка
    «YYYY-MM-DD HH:MM:SS» или Date).
    Используется в селекторе турниров и в свёрнутом списке матчей карточки игрока. %>
<% const typeShort = (typeName) => { const words = typeName.trim().split(/\s+/); return words.length > 1 ? words.map(w => w[0].toUpperCase()).join('') : typeName.trim(); }; %>
<% const d = typeof date === 'string' ? new Date(date.replace(' ', 'T') + 'Z') : date; %>#<%= id %> <%= typeShort(type_name) %> <%= String(d.getDate()).padStart(2, '0') %>.<%= String(d.getMonth() + 1).padStart(2, '0') %>.<%= String(d.getFullYear()).slice(-2) %>
