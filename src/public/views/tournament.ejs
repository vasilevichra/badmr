<% const selected_tournament_id = typeof tournament_id !== 'undefined' ? tournament_id : tournaments.filter(t => t.current === 1)[0].id; %>
<select id="tournament" class="tournament form-select-sm w-auto" onchange="$.post(`/api/tournaments/current/${this.value}`, () => location.href = '/tournament/' + this.value);" required>
    <% tournaments.forEach(tournament => { %>
        <option value="<%= tournament.id %>" <% if (tournament.id === selected_tournament_id) { %>selected <% } %> ><%= tournament.name %></option>
    <% }); %>
</select>