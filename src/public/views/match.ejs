<div class="col-auto text-center">
    <% // номер хронологический: старейший матч сессии — №1 (внизу списка)
        var match_index = total - index; %>
    <% var match_id = Object.keys(match)[0]; %>
    <% var games = Object.values(Object.values(match)[0]).map(g => g[0]); %>
    <% var match_start_date = new Date(games[0]?.match_created_at + 'Z') %>
    <% var court = games[0].court; %>
    <% var user_ids = [1, 2, 3, 4].map(i => games[0][`user_${i}_id`]); %>
    <% var names = [1, 2, 3, 4].map(i => games[0][`name${i}`]); %>
    <% var sexes = [1, 2, 3, 4].map(i => games[0][`sex${i}`]); %>
    <% var pics = [1, 2, 3, 4].map(i => games[0][`pic${i}`]); %>
    <% var losses_1_by = games.map(g => Number(g?.lost_1_by || 0)); %>
    <% var losses_2_by = games.map(g => Number(g?.lost_2_by || 0)); %>
    <% var total_scores_1 = Number(losses_1_by.reduce((a, b) => a + b, 0)); %>
    <% var total_scores_2 = Number(losses_2_by.reduce((a, b) => a + b, 0)); %>
    <% var total_scores = total_scores_1 + total_scores_2; %>

    <% var game_dates = games.map(g => new Date(g.game_created_at + 'Z')); %>
    <% var game_durations_minutes = [Math.round((game_dates[0].getTime() - match_start_date.getTime()) / 60000)]; %>
    <% for (let i = 1; i < games.length; i++) {
        game_durations_minutes.push(Math.round((game_dates[i].getTime() - game_dates[i - 1].getTime()) / 60000));
    } %>
    <% var duration = game_durations_minutes.reduce((d1, d2) => d1 + d2, 0) %>
    <% var score_duration_minutes = total_scores / duration; %>
    <% var rating1 = Number(games[0].rating1); %>
    <% var rating2 = Number(games[0].rating2); %>
    <% var raw_delta1 = games.map(g => g.delta1)[0]; %>
    <% var delta1 = raw_delta1 === null || raw_delta1 === undefined ? null : Number(raw_delta1); %>
    <% // нижняя дельта — зеркальная верхней; у матча калибровки дельты нет (null) %>
    <% var delta2 = delta1 === null ? null : -delta1; %>
    <% // фаворит — пара с большей Σ (средний рейтинг до матча);
        // у фаворита — кубок и разница сумм (+N.NN, дробная часть не длиннее
        // 2 знаков без хвостовых нулей — как в rating-label) %>
    <% var sum_diff = String(Number(Math.abs(rating1 - rating2).toFixed(2))); %>

    <label class="form-label match-history-info">№<%= match_index %> (<%= match_id %>) <nobr class="secondary-info"><%= match_start_date.toLocaleString('ru', {timeZone: 'Europe/Moscow'}) %>, корт №<%= court %></nobr></label>
    <table class="match-history-players table" style="margin-bottom: 3em;">
        <tbody>
        <tr>
            <td class="match-history-delta-col<%= delta1 === null ? '' : delta1 < 0 ? ' rating-minus' : ' rating-plus' %>"><%- include('rating-label', {v: delta1, delta: true}).trim() %></td>
            <td class="match-history-delta-col<% if( delta1 > 0) { %> win<% } %>">〈Σ〉<%- include('rating-label', {v: rating1}).trim() %><% if( rating1 > rating2) { %> <i class="bi bi-trophy match-history-favorite" title="Фаворит"></i> <span class="secondary-info">+<%= sum_diff %></span><% } %></td>
            <% for (let i = 0; i < losses_1_by.length; i++) { %>
                <td rowspan="3" class="match-history-game-col match-history-score<% if(losses_1_by[i] > losses_2_by[i]) { %> win<% } %>"><%= losses_1_by[i] %></td>
            <% } %>
        </tr>
        <tr>
            <td rowspan="2" class="match-history-score<% if( total_scores_1 > total_scores_2) { %> win<% } %>"><%= total_scores_1 %></td>
            <td class="match-history-players-name<% if( delta1 === null) { %><% } else if( delta1 > 0) { %> rating-plus<% } else { %> rating-minus<% } %>" data-user-id="<%= user_ids[0] %>" role="button"><%- playerNameFormatter(user_ids[0], names[0], sexes[0], pics[0]) %></td>
        </tr>
        <tr>
            <td class="match-history-players-name<% if( delta1 === null) { %><% } else if( delta1 > 0) { %> rating-plus<% } else { %> rating-minus<% } %>" data-user-id="<%= user_ids[1] %>" role="button"><%- playerNameFormatter(user_ids[1], names[1], sexes[1], pics[1]) %></td>
        </tr>
        <tr class="match-history-duration">
            <td class="win"><%= duration %>'</td>
            <td>〈Δ〉<%- include('rating-label', {v: Math.abs(rating1 - rating2)}).trim() %></td>
            <% game_durations_minutes.forEach(d => { %>
                <td class="match-history-game-col"><%= d === 0 || d === duration ? Math.round(duration / games.length) : d %>'</td>
            <% }) %>
        </tr>
        <tr>
            <td rowspan="2" class="match-history-score<% if( total_scores_2 > total_scores_1) { %> win<% } %>"><%= total_scores_2 %></td>
            <td class="match-history-players-name<% if( delta2 === null) { %><% } else if( delta2 > 0) { %> rating-plus<% } else { %> rating-minus<% } %>" data-user-id="<%= user_ids[2] %>" role="button"><%- playerNameFormatter(user_ids[2], names[2], sexes[2], pics[2]) %></td>
            <% for (let i = 0; i < losses_1_by.length; i++) { %>
                <td rowspan="3" class="match-history-game-col match-history-score<% if(losses_2_by[i] > losses_1_by[i]) { %> win<% } %>"><%= losses_2_by[i] %></td>
            <% } %>
        </tr>
        <tr>
            <td class="match-history-players-name<% if( delta2 === null) { %><% } else if( delta2 > 0) { %> rating-plus<% } else { %> rating-minus<% } %>" data-user-id="<%= user_ids[3] %>" role="button"><%- playerNameFormatter(user_ids[3], names[3], sexes[3], pics[3]) %></td>
        </tr>
        <tr class="match-history-delta-col">
            <td class="<%= delta2 === null ? '' : delta2 < 0 ? 'rating-minus' : 'rating-plus' %>"><%- include('rating-label', {v: delta2, delta: true}).trim() %></td>
            <td<% if( delta2 !== null && delta2 > 0) { %> class="win"<% } %>>〈Σ〉<%- include('rating-label', {v: rating2}).trim() %><% if( rating2 > rating1) { %> <i class="bi bi-trophy match-history-favorite" title="Фаворит"></i> <span class="secondary-info">+<%= sum_diff %></span><% } %></td>
        </tr>
        </tbody>
    </table>
</div>