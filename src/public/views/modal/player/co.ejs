<tr>
    <% if (typeof win_count !== 'undefined') { %>
        <th style="width: 2em;" scope="row"><span class="no-selection rating-plus"><%= win_count %></span></th>
    <% } else if (typeof lose_count !== 'undefined') { %>
        <th style="width: 2em;" scope="row"><span class="no-selection rating-minus"><%= lose_count %></span></th>
    <% } else if (typeof lose_rate !== 'undefined') { %>
        <th style="width: 4em;" scope="row"><span class="no-selection rating-minus"><%= lose_rate %>%</span></th>
    <% } else if (typeof rate !== 'undefined') { %>
        <th style="width: 4em;" scope="row"><span class="no-selection rating-<%= rate > 50 ? 'plus' : 'minus' %>"><%= rate %>%</span></th>
    <% } %>
    <% // без «#id»: в узкой плитке строка с номером вылезает за рамку;
       // не влезло полное имя — lib.js укоротит его до «Фамилия И.» %>
    <td class="co-player" data-user-id="<%= user_id %>" role="button"><span class="no-selection text-nowrap"><%- playerAvatarFormatter(user_pic, user_name, user_sex) %>&nbsp;<%= user_name %></span></td>
</tr>
