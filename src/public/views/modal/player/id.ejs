<script>
    (function () {
        // вкладка карточки синхронизируется с адресом (?tab=<имя>), чтобы
        // ссылкой с открытой вкладкой можно было поделиться; replaceState —
        // переключения вкладок не засоряют историю назад/вперёд
        const nav = document.getElementById('profileTab');
        if (!nav) {
            return;
        }
        nav.addEventListener('shown.bs.tab', (event) => {
            const url = new URL(location.href);
            const name = event.target.id.replace(/-tab$/, '');
            if (name === 'overview') {
                url.searchParams.delete('tab');
            } else {
                url.searchParams.set('tab', name);
            }
            // при переходе на другую вкладку раскрытие «За всё время» сбрасывается
            url.searchParams.delete('all');
            history.replaceState({}, '', url);
        });

        // раскрытие блоков «За всё время» синхронизируется с адресом (?all=1),
        // чтобы ссылкой с раскрытым списком можно было поделиться
        const allTargets = ['win-all-collapse', 'lose-all-collapse', 'player-same-type-matches'];
        const syncAll = () => {
            const url = new URL(location.href);
            const anyOpen = allTargets.some((id) => document.getElementById(id)?.classList.contains('show'));
            if (anyOpen) {
                url.searchParams.set('all', '1');
            } else {
                url.searchParams.delete('all');
            }
            history.replaceState({}, '', url);
        };
        allTargets.forEach((id) => {
            const el = document.getElementById(id);
            if (!el) {
                return;
            }
            el.addEventListener('shown.bs.collapse', syncAll);
            el.addEventListener('hidden.bs.collapse', syncAll);
        });
    })();
</script>