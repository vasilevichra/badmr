<div class="modal-dialog modal-xl modal-fullscreen-md-down modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Карточка игрока</h5>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Закрыть">
            </button>
        </div>
        <div class="modal-body">
            <section class="bg-body-tertiary py-3">
                <div class="container">
                    <div class="pw-grid">

                        <% // Плитка «личность»: аватар, имя, короткое имя, регион и рейтинг.
                           // Рейтинг правится инпутом внутри бейджа, высота плитки не меняется %>
                        <div class="pw-tile pw-tile-identity">
                            <div class="pw-avatar">
                                <img class="img-fluid" src="<% if (user.pic && (user.pic.slice(0, 4) === 'http' || user.pic.slice(0, 5) === 'data:')) { %><%= user.pic %><% } else if (user.pic) { %>data:image/png;base64, <%= user.pic %><% } else { %>/assets/images/<%= user.sex ? 'pepe' : 'pepe-girl' %>.svg<% } %>" alt="<%= user.lastname %> <%= user.firstname %>">
                            </div>
                            <div class="pw-id-text">
                                <% // под логином имя редактируется по клику (index.js): Enter/фокус — сохранить, Esc — отмена %>
                                <div class="pw-name text-truncate<% if (login) { %> player-window-name<% } %>"<% if (login) { %> data-user-id="<%= user.id %>" title="нажмите, чтобы редактировать"<% } %>><%= user.lastname %> <%= user.firstname %><%= user.patronymic ? ' ' + user.patronymic : '' %></div>
                                <% // короткое имя: показывается всем, если задано; владелец
                                   // (и админ) редактирует по клику — как дату рождения %>
                                <% if (user.shortname || login) { %>
                                <div class="pw-sub<% if (login) { %> player-window-editable<% } %>"<% if (login) { %> data-endpoint="shortname" data-user-id="<%= user.id %>" data-original-text="<%= user.shortname ?? '' %>" data-placeholder="Юра, Лиза…" title="нажмите, чтобы редактировать"<% } %>>
                                    <% if (user.shortname) { %><span class="fw-bold">«<%= user.shortname %>»</span><% } else { %><span class="opacity-50">не задано</span><% } %>
                                </div>
                                <% } %>
                                <div class="pw-sub text-truncate"><%= city.name %> · <%= region.name %> · <%= state.name %></div>
                                <% if (user.club) { %><div class="pw-sub text-truncate"><%= user.club %></div><% } %>
                            </div>
                            <form class="player-window-change-rating-form pw-rating ms-auto">
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <div class="input-group pw-rating-group">
                                    <span class="pw-rating-cap">рейтинг</span>
                                    <% // рейтинга может не быть вовсе (пользователь ещё не калибровался) —
                                       // тогда инпут пустой с плейсхолдером «—» %>
                                    <input class="player-window-change-rating-input form-control border-0" type="number" placeholder="—" maxlength="4" size="3" value="<%= rating ? rating.rating : '' %>" required<% if (!login) { %> disabled<% } %>>
                                    <% if (user.rating_1 || user.rating_2) { %>
                                    <% // рейтинги ЛАБ подстрочниками: 380_1 457_2 — под рейтингом игрока;
                                       // math обёрнут в div: как flex-item MathML ведёт себя некорректно %>
                                    <div class="pw-rating-lab"><math class="text-secondary">
                                        <% if (user.rating_1) { %>
                                        <msub><mi><%= user.rating_1 %></mi><mi>1</mi></msub>
                                        <% } %>
                                        <% if (user.rating_1 && user.rating_2) { %><mspace width="3px"/><% } %>
                                        <% if (user.rating_2) { %>
                                        <msub><mi><%= user.rating_2 %></mi><mi>2</mi></msub>
                                        <% } %>
                                    </math></div>
                                    <% } %>
                                    <% if (login) { %><button class="player-window-change-rating-button bi bi-floppy btn btn-outline-dark border-0" type="button" onclick="$.post(`/api/users/rating/<%= user.id %>?new=${$(this).parent().children('input').val()}`);"></button><% } %>
                                </div>
                            </form>
                        </div>

                        <% // Плитка «Информация»: день рождения, телефон, почта,
                           // аккаунт ЛАБ, привязки VK/TG, прогресс калибровки %>
                        <div class="pw-tile pw-tile-facts">
                            <div class="pw-cap">Информация</div>
                            <% const monthArray = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября',
                                'октября', 'ноября', 'декабря'];
                               // знак зодиака: границы смены знака по дням месяцев,
                               // signs[0] — Козерог (до 20 января и с 22 декабря)
                               const zodiacBounds = [20, 19, 21, 20, 21, 22, 23, 23, 23, 23, 22, 22];
                               const zodiacSigns = ['♑', '♒', '♓', '♈', '♉', '♊', '♋', '♌', '♍', '♎', '♏', '♐', '♑'];
                               const zodiacNames = ['Козерог', 'Водолей', 'Рыбы', 'Овен', 'Телец', 'Близнецы', 'Рак', 'Лев', 'Дева', 'Весы', 'Скорпион', 'Стрелец'];
                               const zodiac = (birthday) => {
                                   const m = Number(birthday.slice(5, 7));
                                   const d = Number(birthday.slice(8, 10));
                                   // текстовый вариант глифа (\uFE0E): монохромный,
                                   // наследует цвет строки фактов, не кричит эмодзи
                                   const sym = zodiacSigns[d >= zodiacBounds[m - 1] ? m : m - 1] + '\uFE0E';
                                   return { sym, name: zodiacNames[d >= zodiacBounds[m - 1] ? m : m - 1] };
                               };
                               const zz = zodiac(user.birthday); %>
                            <% // день рождения: дата и знак зодиака — всем (не приватные данные,
                               // в отличие от года рождения и возраста), с «через N д.»
                               // у правого края %>
                            <div class="pw-fact">
                                <span class="pw-fact-v">
                                    <span class="text-secondary<% if (login) { %> player-window-birthday<% } %>"<% if (login) { %> data-user-id="<%= user.id %>" data-birthday="<%= user.birthday %>" title="нажмите, чтобы редактировать"<% } %>><i class="bi bi-cake2"></i> <%= user.birthday.slice(-2) %> <%= monthArray[Number(user.birthday.slice(5, 7)) - 1] %><% if (login) { %> <%= user.birthday.slice(0, 4) %> (<%= user.age %>)<% } %> <span class="pw-zodiac" data-bs-toggle="tooltip" data-bs-placement="bottom" title="<%= zz.name %>"><%= zz.sym %></span></span>
                                    <span class="text-secondary">через <%= days_until_birthday.days %> д.</span>
                                </span>
                            </div>
                            <% // телефон и почта: редактируются по клику (input внутри строки,
                               // data-endpoint); гостю строки видны,
                               // только если контакт задан %>
                            <% if (user.phone || login) { %>
                            <div class="pw-fact">
                                <span class="pw-fact-v"><span class="text-secondary<% if (!user.phone) { %> opacity-50<% } %><% if (login) { %> player-window-editable<% } %>"<% if (login) { %> data-endpoint="phone" data-user-id="<%= user.id %>" data-original-text="<%= user.phone ?? '' %>" data-placeholder="+79501234567" title="нажмите, чтобы редактировать"<% } %>><i class="bi bi-telephone"></i> <% if (user.phone) { %><%= user.phone %><% } else { %>не задан<% } %></span></span>
                            </div>
                            <% } %>
                            <% // почта: редактируется по клику (input внутри строки, data-endpoint) %>
                            <% if (user.email || login) { %>
                            <div class="pw-fact">
                                <span class="pw-fact-v"><span class="text-secondary<% if (!user.email) { %> opacity-50<% } %><% if (login) { %> player-window-editable<% } %>"<% if (login) { %> data-endpoint="email" data-user-id="<%= user.id %>" data-original-text="<%= user.email ?? '' %>" data-placeholder="mail@example.com" title="нажмите, чтобы редактировать"<% } %>><i class="bi bi-envelope"></i> <% if (user.email) { %><%= user.email %><% } else { %>не задана<% } %></span></span>
                            </div>
                            <% } %>
                            <% if (user.site_id) { %>
                            <% // аккаунт ЛАБ: ссылкой, рейтинги — дублируются из плашки
                               // рейтинга справа; строка скрыта целиком, если нет аккаунта %>
                            <div class="pw-fact pw-lab-row">
                                <span class="pw-lab-badge">ЛАБ</span><a class="player-window-link link-body-emphasis link-offset-2" href="https://badminton4u.ru/players/<%= user.site_id %>" target="_blank" rel="noopener noreferrer"><%= user.site_login || user.site_id %></a>
                                <% if (user.rating_1 || user.rating_2) { %>
                                <span class="pw-fact-v"><math class="text-secondary">
                                    <% if (user.rating_1) { %>
                                    <msub><mi><%= user.rating_1 %></mi><mi>1</mi></msub>
                                    <% } %>
                                    <% if (user.rating_1 && user.rating_2) { %><mspace width="3px"/><% } %>
                                    <% if (user.rating_2) { %>
                                    <msub><mi><%= user.rating_2 %></mi><mi>2</mi></msub>
                                    <% } %>
                                </math></span>
                                <% } %>
                            </div>
                            <% } %>
                            <% // мессенджеры: id привязок — строками после ЛАБ;
                               // кнопки — только в своей карточке: роут действует на req.user %>
                            <div class="pw-fact">
                                <span class="pw-lab-badge">VK</span><span class="pw-fact-v"><span class="pw-msgr text-secondary<% if (!user.vk_id) { %> opacity-50<% } %>"><% if (user.vk_id) { %><% // клик по id — страница VK; слева вместо плашки — аватар, если он уже получен %><% if (user.vk_photo) { %><img class="pw-msgr-avatar" src="<%= user.vk_photo %>" alt=""><% } %><a class="link-secondary link-underline-opacity-0" href="https://vk.com/id<%= user.vk_id %>" target="_blank" rel="noopener noreferrer"><%= user.vk_id %></a><% } else if (login && login.id === user.id) { %>&mdash;<% } else { %>не привязан<% } %></span></span>
                                <% if (login && login.id === user.id) { %>
                                    <% if (!user.vk_id) { %>
                                    <a class="btn-vk-bind btn btn-sm btn-outline-secondary pw-chip-btn" href="/api/auth/vk">Привязать</a>
                                    <% } else { %>
                                    <button class="btn-vk-unbind pw-msgr-unbind" data-user-id="<%= user.id %>" aria-label="Отвязать" title="Отвязать"><i class="bi bi-x-lg"></i></button>
                                    <% } %>
                                <% } %>
                            </div>
                            <div class="pw-fact">
                                <span class="pw-lab-badge">TG</span><span class="pw-fact-v"><span class="pw-msgr text-secondary<% if (!user.tg_id) { %> opacity-50<% } %>"><% if (user.tg_id) { %><% // клик — чат в Telegram: по @username (бот видит его при привязке); без username — просто id %><% if (user.tg_photo) { %><img class="pw-msgr-avatar" src="<%= user.tg_photo %>" alt=""><% } %><% if (user.tg_username) { %><a class="link-secondary link-underline-opacity-0" href="https://t.me/<%= user.tg_username %>" target="_blank" rel="noopener noreferrer">@<%= user.tg_username %></a><% } else { %><%= user.tg_id %><% } %><% } else if (login && login.id === user.id) { %>&mdash;<% } else { %>не привязан<% } %></span></span>
                                <% if (login && login.id === user.id) { %>
                                    <% if (!user.tg_id) { %>
                                    <button class="btn-tg-bind btn btn-sm btn-outline-secondary pw-chip-btn" data-user-id="<%= user.id %>">Привязать</button>
                                    <% } else { %>
                                    <button class="btn-tg-unbind pw-msgr-unbind" data-user-id="<%= user.id %>" aria-label="Отвязать" title="Отвязать"><i class="bi bi-x-lg"></i></button>
                                    <% } %>
                                <% } %>
                            </div>
                            <% // критерии калибровки: сид без матча, протухший рейтинг или идущая серия;
                               // серия отображается накопленная (stale=1), у сида и протухшего — 0;
                               // в завершённом/отменённом турнире прогресс калибровки не показываем %>
                            <% const calibrating = !current_tournament_finished && calibration && calibration_matches > 0 && (calibration.is_seed === 1 || calibration.outdated === 1 || (calibration.stale === 1 && calibration.series <= calibration_matches)); %>
                            <% const cal_series = calibration && calibration.outdated !== 1 && calibration.stale === 1 ? calibration.series : 0; %>
                            <% if (calibrating) { %>
                            <div class="progress mt-2">
                                <div class="progress-bar" role="progressbar" style="width: <%= Math.round(cal_series / calibration_matches * 100) %>%" aria-valuenow="<%= Math.round(cal_series / calibration_matches * 100) %>" aria-valuemin="0" aria-valuemax="100">Калибровка (<%= cal_series %> из <%= calibration_matches %>)</div>
                            </div>
                            <% } %>
                        </div>

                        <% if (worst_opponents.length) { %>
                        <% // плитка «Шанс проиграть»: соперники по доле поражений,
                            // в стиле плитки «Шанс выиграть» — «имя — полоса»;
                            // раньше была табом, теперь заполняет колонку рядом с достижениями %>
                        <div class="pw-tile pw-tile-worst">
                            <div class="pw-cap">Шанс проиграть, %</div>
                            <div class="pw-chance-list">
                            <% worst_opponents.forEach((o) => { %>
                                <% // 71.43 → 71 — округляем до целых; полоса красная,
                                   // когда вероятность проиграть не ниже половины %>
                                <div class="pw-chance-row co-player" data-user-id="<%= o.user_id %>" role="button">
                                    <span class="pw-chance-name"><span class="no-selection text-nowrap"><%- playerAvatarFormatter(o.user_pic, o.user_name, o.user_sex) %>&nbsp;<%= o.user_name %></span></span>
                                    <span class="pw-chance-bar<%= Number(o.lose_rate) >= 50 ? ' bad' : '' %>"><i style="width: <%= Math.round(Number(o.lose_rate)) %>%"></i></span>
                                </div>
                            <% }); %>
                            </div>
                        </div>
                        <% } %>

                        <% if (buddies.length) { %>
                        <% // плитка «Шанс выиграть»: соперники с полосой процента;
                           // раньше была табом, теперь стоит рядом с «Шанс проиграть» %>
                        <div class="pw-tile pw-tile-chance">
                            <div class="pw-cap">Шанс выиграть, %</div>
                            <div class="pw-chance-list">
                            <% buddies.forEach((b) => { %>
                                <% // 66.67 → 67 — округляем до целых; значение видно по полосе и её цвету, цифры не дублируем %>
                                <div class="pw-chance-row co-player" data-user-id="<%= b.user_id %>" role="button">
                                    <span class="pw-chance-name"><span class="no-selection text-nowrap"><%- playerAvatarFormatter(b.user_pic, b.user_name, b.user_sex) %>&nbsp;<%= b.user_name %></span></span>
                                    <span class="pw-chance-bar<%= Number(b.win_rate) <= 50 ? ' bad' : '' %>"><i style="width: <%= Math.round(Number(b.win_rate)) %>%"></i></span>
                                </div>
                            <% }); %>
                            </div>
                        </div>
                        <% } %>

                        <% // мини-плитки метрик — самостоятельные плитки bento-сетки,
                            // раньше жили в табе «Обзор», таб упразднён; разбиты на две
                            // группы под ряды сетки: объёмы (4 штуки в ряд) и исходы
                            // (3 штуки в ряд) — оба ряда заполнены без пустот %>
                        <% const single_tournament = !type_matches.length;
                           const wins_t = co_winners.map(w => w.win_count).reduce((acc, curr) => acc + curr, 0);
                           const loses_t = co_losers.map(l => l.lose_count).reduce((acc, curr) => acc + curr, 0);
                           const win_rate_t = matches.count ? (wins_t / matches.count * 100).toFixed(2) : 0;
                           const wins_a = co_winners_all.map(w => w.win_count).reduce((acc, curr) => acc + curr, 0);
                           const loses_a = co_losers_all.map(l => l.lose_count).reduce((acc, curr) => acc + curr, 0);
                           const win_rate_a = matches_total.count ? (wins_a / matches_total.count * 100).toFixed(2) : 0;
                           const matches3_t = Number(games.count) - 2 * Number(matches.count);
                           const matches3_a = Number(games_total.count) - 2 * Number(matches_total.count); %>
                        <%- include('stat', {cap: 'Матчей', val: matches.count, sub: single_tournament ? '' : matches_total.count, val_class: '', cls: 'pw-stat-sm'}); %>
                        <%- include('stat', {cap: 'Игр', val: games.count, sub: single_tournament ? '' : games_total.count, val_class: '', cls: 'pw-stat-sm'}); %>
                        <%- include('stat', {cap: 'Игр на матч', val: matches.count ? (Number(games.count) / Number(matches.count)).toFixed(2) : 0, sub: single_tournament ? '' : (matches_total.count ? (Number(games_total.count) / Number(matches_total.count)).toFixed(2) : 0), val_class: '', cls: 'pw-stat-sm'}); %>
                        <%- include('stat', {cap: 'Матчей из 3 игр', val: `${matches3_t} (${matches.count ? Math.round(matches3_t / matches.count * 100) : 0}%)`, sub: single_tournament ? '' : `${matches3_a} (${matches_total.count ? Math.round(matches3_a / matches_total.count * 100) : 0}%)`, val_class: '', cls: 'pw-stat-sm'}); %>

                        <% if (co_winners.length || co_winners_all.length) { %>
                        <% // плитка «Выигрывает»: напарники, с которыми игрок выигрывал;
                            // раньше была табом, теперь — плашка сразу за «Винрейтом» %>
                        <div class="pw-tile pw-tile-win">
                            <div class="pw-cap">Выигрывает</div>
                            <% if (co_winners.length) { %>
                            <div class="pw-co-list">
                            <table class="table table-sm no-selection mb-0">
                                <tbody>
                                <% co_winners.forEach((w) => { %>
                                    <%- include('co', {win_count: w.win_count, user_id: w.user_id, user_name: w.user_name, user_sex: w.user_sex, user_pic: w.user_pic}); %>
                                <% }); %>
                                </tbody>
                            </table>
                            </div>
                            <% } %>
                            <% if (co_winners_all.length && type_matches.length) { %>
                            <%# «За всё время» скрывается, если других турниров того же типа
                                у игрока нет (type_matches пуст): список совпадёт с таблицей
                                напарников этого турнира выше — дубль без новой информации %>
                            <a class="link-body-emphasis link-underline-opacity-0 d-inline-block mt-2" data-bs-toggle="collapse" href="#win-all-collapse" role="button" aria-expanded="<%= expand_all %>" aria-controls="win-all-collapse">
                                <i class="bi bi-chevron-down"></i> за всё время
                            </a>
                            <div class="collapse<%= expand_all ? ' show' : '' %>" id="win-all-collapse">
                                <table class="table table-sm no-selection mb-0">
                                    <tbody>
                                    <% co_winners_all.forEach((w) => { %>
                                        <%- include('co', {win_count: w.win_count, user_id: w.user_id, user_name: w.user_name, user_sex: w.user_sex, user_pic: w.user_pic}); %>
                                    <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <% } %>
                        </div>
                        <% } %>

                        <% if (co_losers.length || co_losers_all.length) { %>
                        <% // плитка «Проигрывает»: игроки, с которыми игрок проигрывал,
                            // в стиле плитки «Выигрывает», сразу за ней %>
                        <div class="pw-tile pw-tile-lose">
                            <div class="pw-cap">Проигрывает</div>
                            <% if (co_losers.length) { %>
                            <div class="pw-co-list">
                            <table class="table table-sm no-selection mb-0">
                                <tbody>
                                <% co_losers.forEach((l) => { %>
                                    <%- include('co', {lose_count: l.lose_count, user_id: l.user_id, user_name: l.user_name, user_sex: l.user_sex, user_pic: l.user_pic}); %>
                                <% }); %>
                                </tbody>
                            </table>
                            </div>
                            <% } %>
                            <% if (co_losers_all.length && type_matches.length) { %>
                            <%# «За всё время» скрывается, если других турниров того же типа
                                у игрока нет (type_matches пуст): список совпадёт с таблицей
                                выше — дубль без новой информации %>
                            <a class="link-body-emphasis link-underline-opacity-0 d-inline-block mt-2" data-bs-toggle="collapse" href="#lose-all-collapse" role="button" aria-expanded="<%= expand_all %>" aria-controls="lose-all-collapse">
                                <i class="bi bi-chevron-down"></i> за всё время
                            </a>
                            <div class="collapse<%= expand_all ? ' show' : '' %>" id="lose-all-collapse">
                                <table class="table table-sm no-selection mb-0">
                                    <tbody>
                                    <% co_losers_all.forEach((l) => { %>
                                        <%- include('co', {lose_count: l.lose_count, user_id: l.user_id, user_name: l.user_name, user_sex: l.user_sex, user_pic: l.user_pic}); %>
                                    <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <% } %>
                        </div>
                        <% } %>

                        <% // плитка «Достижения»: третья плитка ряда напарников —
                            // заполняет ряд до 12 колонок; без достижений — приглушённая пометка %>
                        <div class="pw-tile pw-tile-ach">
                            <div class="pw-cap">Достижения</div>
                            <% if (achievements.length) { %>
                            <div class="d-flex flex-wrap gap-2">
                                <% achievements.forEach((a) => { %>
                                    <span class="achievement-badge badge text-bg-primary" title="<%= a.description %>"><i class="bi <%= a.icon %>"></i> <%= a.title %></span>
                                <% }) %>
                            </div>
                            <% } else { %>
                            <span class="text-secondary opacity-50">пока нет</span>
                            <% } %>
                        </div>

                        <% // исходы — второй ряд метрик: 3 плитки заполняют ряд целиком %>
                        <%- include('stat', {cap: 'Победы', val: wins_t, sub: single_tournament ? '' : wins_a, val_class: 'rating-plus', cls: ''}); %>
                        <%- include('stat', {cap: 'Поражения', val: loses_t, sub: single_tournament ? '' : loses_a, val_class: 'rating-minus', cls: ''}); %>
                        <%- include('stat', {cap: 'Винрейт', val: `${win_rate_t}%`, sub: single_tournament ? '' : `${win_rate_a}%`, val_class: `rating-${win_rate_t > 50 ? 'plus' : 'minus'}`, cls: ''}); %>

                        <% // плитка «Матчи»: история матчей игрока (табы упразднены) %>
                        <% if (user_matches.length || type_matches.length) { %>
                        <div class="pw-tile pw-tile-matches">
                            <div class="pw-cap">Матчи</div>
                                            <!-- id отличается от страничного #match-history-block: периодический
                                                 рефреш $(‘#match-history-block’).load(...) затрагивает все элементы
                                                 с этим id и затирал бы фильтр по игроку всеми матчами турнира -->
                                            <div id="player-match-history-block" class="row justify-content-center mx-auto">
                                                <% user_matches.forEach((m, i) => { %>
                                                    <%- include('../../match', {index: i, match: m, total: user_matches.length}); %>
                                                <% }) %>
                                            </div>
                                            <% if (type_matches.length) { %>
                                            <% // свёрнутые матчи турниров того же типа (#57): одна строка на матч %>
                                            <div class="mt-3">
                                                <a class="link-body-emphasis link-underline-opacity-0" data-bs-toggle="collapse" href="#player-same-type-matches" role="button" aria-expanded="false" aria-controls="player-same-type-matches">
                                                    <i class="bi bi-chevron-down"></i> остальные матчи (<%= type_matches.length %>)
                                                </a>
                                                <div class="collapse<%= expand_all ? ' show' : '' %>" id="player-same-type-matches">
                                                    <% // компактная таблица: подпись турнира (#id тип город дата),
                                                       // пара игрока первой (её счёт первым), имя игрока жирным,
                                                       // игроки в стандартном формате и кликабельны (открывают карточку),
                                                       // пары идут колонками: пара игрока (игрок, под ним
                                                       // партнёр), затем пара соперников; подпись/счёт/дельта
                                                       // объединены rowspan'ом на 2 строки; первая колонка —
                                                       // слева, остальные — по центру; шрифты — как в таблицах
                                                       // матчей (match-history-*),
                                                       // дельта рейтинга игрока с цветом, дробная часть — без хвостовых нулей %>
                                                    <% const playerHtml = (uid, name, sex, pic) =>
                                                        (uid === user.id ? '<strong>' : '') +
                                                        `<span class="co-player" data-user-id="${uid}" role="button">` +
                                                        playerNameFormatter(uid, name, sex, pic) + '</span>' +
                                                        (uid === user.id ? '</strong>' : ''); %>
                                                    <% if (is_mobile) { %>
                                                    <table class="table table-sm no-selection mb-0 same-type-mobile">
                                                        <tbody>
                                                        <% type_matches.forEach((m) => {
                                                            // пара игрока показывается первой: счёт блока — её часть
                                                            // общего счёта, дельта — в блоке пары с игроком карточки
                                                            const mine_first = m.user_1_id === user.id || m.user_2_id === user.id;
                                                            const scoreA = mine_first ? m.wins1 : m.wins2;
                                                            const scoreB = mine_first ? m.wins2 : m.wins1;
                                                            // дельта — всегда дельта игрока карточки и всегда в его
                                                            // блоке: pairA — это пара игрока карточки независимо
                                                            // от того, user_1/2 он или user_3/4 в матче
                                                            const deltaA = m.delta;
                                                            const deltaB = null;
                                                            const pairA = mine_first
                                                                ? [[m.user_1_id, m.name1, m.sex1, m.pic1], [m.user_2_id, m.name2, m.sex2, m.pic2]]
                                                                : [[m.user_3_id, m.name3, m.sex3, m.pic3], [m.user_4_id, m.name4, m.sex4, m.pic4]];
                                                            const pairB = mine_first
                                                                ? [[m.user_3_id, m.name3, m.sex3, m.pic3], [m.user_4_id, m.name4, m.sex4, m.pic4]]
                                                                : [[m.user_1_id, m.name1, m.sex1, m.pic1], [m.user_2_id, m.name2, m.sex2, m.pic2]]; %>
                                                            <tr class="same-type-tournament">
                                                                <td colspan="3" class="same-type-tournament-cell"><%- include('../../tournament-label', {id: m.tournament_id, type_name: m.tournament_type_name, city: m.tournament_city, date: m.match_created_at}).trim() %></td>
                                                            </tr>
                                                            <tr>
                                                                <td class="same-type-name"><%- playerHtml(...pairA[0]) %></td>
                                                                <td rowspan="2" class="same-type-score"><span class="rating-<%= scoreA > scoreB ? 'plus' : 'minus' %> fw-bold"><%= scoreA %></span></td>
                                                                <td rowspan="2" class="same-type-delta"><%- include('../../rating-label', {v: deltaA, delta: true, calibration: m.calibrated === 1}).trim() %></td>
                                                            </tr>
                                                            <tr>
                                                                <td class="same-type-name"><%- playerHtml(...pairA[1]) %></td>
                                                            </tr>
                                                            <tr class="same-type-divider">
                                                                <td class="same-type-name"><%- playerHtml(...pairB[0]) %></td>
                                                                <td rowspan="2" class="same-type-score"><span class="rating-<%= scoreB > scoreA ? 'plus' : 'minus' %> fw-bold"><%= scoreB %></span></td>
                                                                <td rowspan="2" class="same-type-delta"><%- include('../../rating-label', {v: deltaB, delta: true, calibration: m.calibrated === 1}).trim() %></td>
                                                            </tr>
                                                            <tr>
                                                                <td class="same-type-name"><%- playerHtml(...pairB[1]) %></td>
                                                            </tr>
                                                        <% }) %>
                                                        </tbody>
                                                    </table>
                                                    <% } else { %>
                                                    <table class="table table-sm no-selection mb-0">
                                                        <tbody>
                                                        <% type_matches.forEach((m) => { %>
                                                            <% // пара игрока показывается первой, её счёт — первым числом %>
                                                            <% const mine_first = m.user_1_id === user.id || m.user_2_id === user.id;
                                                               const mine_wins = mine_first ? m.wins1 : m.wins2;
                                                               const their_wins = mine_first ? m.wins2 : m.wins1;
                                                               const pairA = mine_first
                                                                   ? [[m.user_1_id, m.name1, m.sex1, m.pic1], [m.user_2_id, m.name2, m.sex2, m.pic2]]
                                                                   : [[m.user_3_id, m.name3, m.sex3, m.pic3], [m.user_4_id, m.name4, m.sex4, m.pic4]];
                                                               const pairB = mine_first
                                                                   ? [[m.user_3_id, m.name3, m.sex3, m.pic3], [m.user_4_id, m.name4, m.sex4, m.pic4]]
                                                                   : [[m.user_1_id, m.name1, m.sex1, m.pic1], [m.user_2_id, m.name2, m.sex2, m.pic2]]; %>
                                                            <tr>
                                                                <td rowspan="2" class="match-history-info"><%- include('../../tournament-label', {id: m.tournament_id, type_name: m.tournament_type_name, city: m.tournament_city, date: m.match_created_at}).trim() %></td>
                                                                <td class="text-center match-history-players-name"><%- playerHtml(...pairA[0]) %></td>
                                                                <td rowspan="2" class="text-center match-history-score"><span class="rating-<%= mine_wins > their_wins ? 'plus' : 'minus' %> fw-bold"><%= mine_wins %>:<%= their_wins %></span></td>
                                                                <td class="text-center match-history-players-name"><%- playerHtml(...pairB[0]) %></td>
                                                                <td rowspan="2" class="text-center match-history-delta-col"><%- include('../../rating-label', {v: m.delta, delta: true}).trim() %></td>
                                                            </tr>
                                                            <tr>
                                                                <td class="text-center match-history-players-name"><%- playerHtml(...pairA[1]) %></td>
                                                                <td class="text-center match-history-players-name"><%- playerHtml(...pairB[1]) %></td>
                                                            </tr>
                                                        <% }) %>
                                                        </tbody>
                                                    </table>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <% } %>
                        </div>
                        <% } %>

                                    <% // плитка «Рейтинг»: график истории рейтинга;
                                       // раньше жил в табе «Обзор», теперь стоит после статистики %>
                                    <div class="pw-tile pw-tile-rating">
                                        <div class="pw-cap">Рейтинг</div>
                                        <canvas id="player-window-rating" height="120"></canvas>
                                    </div>
                                </div>
                            </div>
            </section>
        </div>
    </div>
</div>
<script>
    (function () {
        // раскрытие блоков «За всё время» синхронизируется с адресом (?all=1),
        // чтобы ссылкой с раскрытым списком можно было поделиться
        const allTargets = ['win-all-collapse', 'lose-all-collapse', 'player-same-type-matches'];
        const syncAll = () => {
            const url = new URL(location.href);
            const anyOpen = allTargets.some((id) => document.getElementById(id)?.classList.contains('show'));
            if (anyOpen) {
                url.searchParams.set('all', '1');
            } else {
                url.searchParams.delete('all');
            }
            history.replaceState({}, '', url);
        };
        allTargets.forEach((id) => {
            const el = document.getElementById(id);
            if (!el) {
                return;
            }
            el.addEventListener('shown.bs.collapse', syncAll);
            el.addEventListener('hidden.bs.collapse', syncAll);
        });
    })();
</script>