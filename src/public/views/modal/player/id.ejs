<div class="modal-dialog modal-fullscreen modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Карточка игрока</h5>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Закрыть">
            </button>
        </div>
        <div class="modal-body">
            <section class="bg-light py-3 py-md-5 py-xl-8">
                <div class="container">
                    <div class="row gy-4 gy-lg-0">
                        <div class="col-12 col-lg-4 col-xl-3">
                            <div class="row gy-4">
                                <div class="col-12">
                                    <div class="card widget-card border-light shadow-sm">
                                        <div class="card-header text-bg-primary text-truncate"><%= user.lastname %> <%= user.firstname %> <%= user.patronymic %></div>
                                        <div class="card-body">
                                            <div class="text-center mb-3">
                                                <img class="img-fluid"
                                                     src="<% if (user.pic && (user.pic.slice(0, 4) === 'http' || user.pic.slice(0, 5) === 'data:')) { %><%= user.pic %><% } else if (user.pic) { %>data:image/png;base64, <%= user.pic %><% } else { %>/assets/images/<%= user.sex ? 'pepe' : 'pepe-girl' %>.svg<% } %>"
                                                     alt="user@email.com">
                                            </div>
                                            <p>
                                            <h5 class="text-center mb-1"><%= city.name %></h5>
                                            <div class="text-center text-secondary"><%= region.name %></div>
                                            <div class="text-center text-secondary mb-2"><%= state.name %></div>
                                            </p>
                                            <% const monthArray = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября',
                                                'октября', 'ноября', 'декабря']; %>
                                            <p>
                                            <div class="text-center text-secondary"><i class="bi bi-cake2"> </i><%= user.birthday.slice(
                                                        -2) %> <%= monthArray[Number(user.birthday.slice(5, 7)) - 1] %>
                                                <% if (login && login.id === user.id) { %> <%= user.birthday.slice(0, 4) %> (<%= user.age %>)
                                                <% } %>
                                            </div>
                                            <div class="text-center text-secondary">через <%= days_until_birthday.days %> д.</div>
                                            </p>
                                            <% if (user.club) { %><p class="text-center text-secondary"><%= user.club %></p><% } %>
                                            <p>
                                            <form class="player-window-change-rating-form">
                                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                <div class="input-group">
                                                    <div class="text-center text-secondary form-control border-0"><i class="bi bi-activity"></i> Рейтинг</div>
                                                    <input class="player-window-change-rating-input form-control border-0" type="number" placeholder="рейтинг" maxlength="4" size="3" value="<%= rating.rating %>" required<% if (!login) { %> disabled<% } %>>
                                                    <% if (login) { %><button class="player-window-change-rating-button bi bi-floppy btn btn-outline-dark border-0 mx-2" type="button" onclick="$.post(`/api/users/rating/<%= user.id %>?new=${$(this).parent().children('input').val()}`);"></button><% } %>
                                                </div>
                                            </form>
                                            <% // блок ЛАБ: скрывается целиком, если нет аккаунта ЛАБ (site_id);
                                               // рейтинг ЛАБ показывается только если есть %>
                                            <% if (user.site_id) { %>
                                            <div class="text-center text-secondary mt-3">
                                                <i class="bi bi-at"></i><a class="player-window-link link-dark link-offset-2  me-2" href="https://badminton4u.ru/players/<%= user.site_id %>" target="_blank" rel="noopener noreferrer"><%= user.site_login || user.site_id %></a>
                                                <% if (user.rating_1 || user.rating_2) { %>
                                                <math class="secondary-info">
                                                    <% if (user.rating_1) { %>
                                                    <msub>
                                                        <mi><%= user.rating_1 %></mi>
                                                        <mi>1</mi>
                                                    </msub>
                                                    <% } %>
                                                    <% if (user.rating_1 && user.rating_2) { %>
                                                    <mspace width="3px"/>
                                                    <% } %>
                                                    <% if (user.rating_2) { %>
                                                    <msub>
                                                        <mi><%= user.rating_2 %></mi>
                                                        <mi>2</mi>
                                                    </msub>
                                                    <% } %>
                                                </math>
                                                <% } %>
                                            </div>
                                            <% } %>
                                            <% // критерии калибровки: сид без матча, протухший рейтинг или идущая серия;
                                               // серия отображается накопленная (stale=1), у сида и протухшего — 0;
                                               // в завершённом/отменённом турнире прогресс калибровки не показываем %>
                                            <% const calibrating = !current_tournament_finished && calibration && calibration_matches > 0 && (calibration.is_seed === 1 || calibration.outdated === 1 || (calibration.stale === 1 && calibration.series <= calibration_matches)); %>
                                            <% const cal_series = calibration && calibration.outdated !== 1 && calibration.stale === 1 ? calibration.series : 0; %>
                                            <% if (calibrating) { %>
                                            <div class="progress mt-2">
                                                <div class="progress-bar" role="progressbar" style="width: <%= Math.round(cal_series / calibration_matches * 100) %>%" aria-valuenow="<%= Math.round(cal_series / calibration_matches * 100) %>" aria-valuemin="0" aria-valuemax="100">Калибровка (<%= cal_series %> из <%= calibration_matches %>)</div>
                                            </div>
                                            <% } %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
<!--                                <div class="col-12">-->
<!--                                    <div class="card widget-card border-light shadow-sm">-->
<!--                                        <div class="card-header text-bg-primary">Social Accounts</div>-->
<!--                                        <div class="card-body">-->
<!--                                            <a href="#!" class="d-inline-block bg-dark link-light lh-1 p-2 rounded">-->
<!--                                                <i class="bi bi-youtube"></i>-->
<!--                                            </a>-->
<!--                                            <a href="#!" class="d-inline-block bg-dark link-light lh-1 p-2 rounded">-->
<!--                                                <i class="bi bi-twitter-x"></i>-->
<!--                                            </a>-->
<!--                                            <a href="#!" class="d-inline-block bg-dark link-light lh-1 p-2 rounded">-->
<!--                                                <i class="bi bi-facebook"></i>-->
<!--                                            </a>-->
<!--                                            <a href="#!" class="d-inline-block bg-dark link-light lh-1 p-2 rounded">-->
<!--                                                <i class="bi bi-linkedin"></i>-->
<!--                                            </a>-->
<!--                                        </div>-->
<!--                                    </div>-->
<!--                                </div>-->
                                <% if (achievements.length) { %>
                                <div class="col-12">
                                    <div class="card widget-card border-light shadow-sm">
                                        <div class="card-header text-bg-primary">Достижения</div>
                                        <div class="card-body">
                                            <div class="d-flex flex-wrap gap-2">
                                                <% achievements.forEach((a) => { %>
                                                    <span class="achievement-badge badge text-bg-primary" title="<%= a.description %>"><i class="bi <%= a.icon %>"></i> <%= a.title %></span>
                                                <% }) %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
                            </div>
                        </div>
                        <div class="col-12 col-lg-8 col-xl-9">
                            <div class="card widget-card border-light shadow-sm">
                                <div class="card-body p-4">
                                    <ul class="nav nav-tabs" id="profileTab" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link<%= active_tab === 'overview' ? ' active' : '' %>" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-tab-pane" type="button" role="tab" aria-controls="overview-tab-pane" aria-selected="<%= active_tab === 'overview' %>">Обзор</button>
                                        </li>
                                        <% if (user_matches.length || type_matches.length) { %>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link<%= active_tab === 'matches' ? ' active' : '' %>" id="matches-tab" data-bs-toggle="tab" data-bs-target="#matches-tab-pane" type="button"
                                                    role="tab" aria-controls="matches-tab-pane" aria-selected="<%= active_tab === 'matches' %>">Матчи
                                            </button>
                                        </li>
                                        <% } %>
                                        <% if (co_winners.length || co_winners_all.length) { %>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link<%= active_tab === 'win' ? ' active' : '' %>" id="win-tab" data-bs-toggle="tab" data-bs-target="#win-tab-pane" type="button"
                                                    role="tab" aria-controls="win-tab-pane" aria-selected="<%= active_tab === 'win' %>">Выигрывает
                                            </button>
                                        </li>
                                        <% } %>
                                        <% if (co_losers.length || co_losers_all.length) { %>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link<%= active_tab === 'lose' ? ' active' : '' %>" id="lose-tab" data-bs-toggle="tab" data-bs-target="#lose-tab-pane" type="button"
                                                    role="tab" aria-controls="lose-tab-pane" aria-selected="<%= active_tab === 'lose' %>">Проигрывает
                                            </button>
                                        </li>
                                        <% } %>
                                        <% if (buddies.length) { %>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link<%= active_tab === 'chance' ? ' active' : '' %>" id="chance-tab" data-bs-toggle="tab" data-bs-target="#chance-tab-pane" type="button"
                                                    role="tab" aria-controls="chance-tab-pane" aria-selected="<%= active_tab === 'chance' %>">Шанс
                                            </button>
                                        </li>
                                        <% } %>
                                        <% if (worst_opponents.length) { %>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link<%= active_tab === 'worst' ? ' active' : '' %>" id="worst-tab" data-bs-toggle="tab" data-bs-target="#worst-tab-pane" type="button"
                                                    role="tab" aria-controls="worst-tab-pane" aria-selected="<%= active_tab === 'worst' %>">Неудобные
                                            </button>
                                        </li>
                                        <% } %>
<!--                                        <li class="nav-item" role="presentation">-->
<!--                                            <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-tab-pane" type="button"-->
<!--                                                    role="tab" aria-controls="profile-tab-pane" aria-selected="false">Profile-->
<!--                                            </button>-->
<!--                                        </li>-->
<!--                                        <li class="nav-item" role="presentation">-->
<!--                                            <button class="nav-link" id="email-tab" data-bs-toggle="tab" data-bs-target="#email-tab-pane" type="button"-->
<!--                                                    role="tab" aria-controls="email-tab-pane" aria-selected="false">Emails-->
<!--                                            </button>-->
<!--                                        </li>-->
<!--                                        <li class="nav-item" role="presentation">-->
<!--                                            <button class="nav-link" id="password-tab" data-bs-toggle="tab" data-bs-target="#password-tab-pane" type="button"-->
<!--                                                    role="tab" aria-controls="password-tab-pane" aria-selected="false">Password-->
<!--                                            </button>-->
<!--                                        </li>-->
                                    </ul>
                                    <div class="tab-content pt-4" id="profileTabContent">
                                        <div class="tab-pane fade<%= active_tab === 'overview' ? ' show active' : '' %>" id="overview-tab-pane" role="tabpanel" aria-labelledby="overview-tab"
                                             tabindex="0">
                                            <div class="row g-0">
                                                <% // разделение статистики: на этом турнире / за всё время (#57) %>
                                                <% const wins_t = co_winners.map(w => w.win_count).reduce((acc, curr) => acc + curr, 0); %>
                                                <% const loses_t = co_losers.map(l => l.lose_count).reduce((acc, curr) => acc + curr, 0); %>
                                                <% const win_rate_t = matches.count ? (wins_t / matches.count * 100).toFixed(2) : 0; %>
                                                <% const wins_a = co_winners_all.map(w => w.win_count).reduce((acc, curr) => acc + curr, 0); %>
                                                <% const loses_a = co_losers_all.map(l => l.lose_count).reduce((acc, curr) => acc + curr, 0); %>
                                                <% const win_rate_a = matches_total.count ? (wins_a / matches_total.count * 100).toFixed(2) : 0; %>
                                                <% const matches3_t = Number(games.count) - 2 * Number(matches.count); %>
                                                <% const matches3_a = Number(games_total.count) - 2 * Number(matches_total.count); %>
                                                <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                                    <div class="p-2">Параметр</div>
                                                </div>
                                                <div class="col-3 col-md-3 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2 fw-bold">На этом турнире</div>
                                                </div>
                                                <div class="col-4 col-md-6 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2 fw-bold">За всё время</div>
                                                </div>
                                                <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                                    <div class="p-2">Матчей</div>
                                                </div>
                                                <div class="col-3 col-md-3 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2"><%= matches.count %></div>
                                                </div>
                                                <div class="col-4 col-md-6 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2"><%= matches_total.count %></div>
                                                </div>
                                                <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                                    <div class="p-2">Игр</div>
                                                </div>
                                                <div class="col-3 col-md-3 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2"><%= games.count %></div>
                                                </div>
                                                <div class="col-4 col-md-6 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2"><%= games_total.count %></div>
                                                </div>
                                                <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                                    <div class="p-2">Игр на матч</div>
                                                </div>
                                                <div class="col-3 col-md-3 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2"><%= matches.count ? (Number(games.count) / Number(matches.count)).toFixed(2) : 0; %></div>
                                                </div>
                                                <div class="col-4 col-md-6 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2"><%= matches_total.count ? (Number(games_total.count) / Number(matches_total.count)).toFixed(2) : 0; %></div>
                                                </div>
                                                <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                                    <div class="p-2">Матчей из трёх игр</div>
                                                </div>
                                                <div class="col-3 col-md-3 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2"><%= matches3_t %> (<%= matches.count ? (matches3_t / matches.count * 100).toFixed(2) : 0; %>%)</div>
                                                </div>
                                                <div class="col-4 col-md-6 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2"><%= matches3_a %> (<%= matches_total.count ? (matches3_a / matches_total.count * 100).toFixed(2) : 0; %>%)</div>
                                                </div>
                                                <div class="col-5 col-md-3 bg-light border-bottom border-white border-3">
                                                    <div class="p-2">Побед / Поражений / %</div>
                                                </div>
                                                <div class="col-3 col-md-3 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2"><span class="rating-plus"><%= wins_t %></span> / <span class="rating-minus"><%= loses_t %></span> / <span class="rating-<%= win_rate_t > 50 ? 'plus' : 'minus' %>"><%= win_rate_t %>%</span></div>
                                                </div>
                                                <div class="col-4 col-md-6 bg-light border-start border-bottom border-white border-3">
                                                    <div class="p-2"><span class="rating-plus"><%= wins_a %></span> / <span class="rating-minus"><%= loses_a %></span> / <span class="rating-<%= win_rate_a > 50 ? 'plus' : 'minus' %>"><%= win_rate_a %>%</span></div>
                                                </div>
                                            </div>
                                            <canvas id="player-window-rating" height="120"></canvas>
                                        </div>
                                        <div class="tab-pane fade<%= active_tab === 'win' ? ' show active' : '' %>" id="win-tab-pane" role="tabpanel" aria-labelledby="win-tab" tabindex="0">
                                            <div class="p-2">
                                                <% if (co_winners.length) { %>
                                                <table class="table no-selection">
                                                    <tbody>
                                                    <% co_winners.forEach((w) => { %>
                                                        <%- include('co', {win_count: w.win_count, user_id: w.user_id, user_name: w.user_name, user_sex: w.user_sex, user_pic: w.user_pic}); %>
                                                    <% }); %>
                                                    </tbody>
                                                </table>
                                                <% } %>
                                                <% if (co_winners_all.length) { %>
                                                <a class="link-dark link-underline-opacity-0" data-bs-toggle="collapse" href="#win-all-collapse" role="button" aria-expanded="<%= expand_all %>" aria-controls="win-all-collapse">
                                                    <i class="bi bi-chevron-down"></i> За всё время
                                                </a>
                                                <div class="collapse<%= expand_all ? ' show' : '' %>" id="win-all-collapse">
                                                    <table class="table no-selection">
                                                        <tbody>
                                                        <% co_winners_all.forEach((w) => { %>
                                                            <%- include('co', {win_count: w.win_count, user_id: w.user_id, user_name: w.user_name, user_sex: w.user_sex, user_pic: w.user_pic}); %>
                                                        <% }); %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="tab-pane fade<%= active_tab === 'lose' ? ' show active' : '' %>" id="lose-tab-pane" role="tabpanel" aria-labelledby="lose-tab" tabindex="0">
                                            <div class="p-2">
                                                <% if (co_losers.length) { %>
                                                <table class="table no-selection">
                                                    <tbody>
                                                    <% co_losers.forEach((l) => { %>
                                                        <%- include('co', {lose_count: l.lose_count, user_id: l.user_id, user_name: l.user_name, user_sex: l.user_sex, user_pic: l.user_pic}); %>
                                                    <% }); %>
                                                    </tbody>
                                                </table>
                                                <% } %>
                                                <% if (co_losers_all.length) { %>
                                                <a class="link-dark link-underline-opacity-0" data-bs-toggle="collapse" href="#lose-all-collapse" role="button" aria-expanded="<%= expand_all %>" aria-controls="lose-all-collapse">
                                                    <i class="bi bi-chevron-down"></i> За всё время
                                                </a>
                                                <div class="collapse<%= expand_all ? ' show' : '' %>" id="lose-all-collapse">
                                                    <table class="table no-selection">
                                                        <tbody>
                                                        <% co_losers_all.forEach((l) => { %>
                                                            <%- include('co', {lose_count: l.lose_count, user_id: l.user_id, user_name: l.user_name, user_sex: l.user_sex, user_pic: l.user_pic}); %>
                                                        <% }); %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="tab-pane fade<%= active_tab === 'chance' ? ' show active' : '' %>" id="chance-tab-pane" role="tabpanel" aria-labelledby="win-tab" tabindex="0">
                                            <div class="p-2">
                                                <table class="table no-selection">
                                                    <tbody>
                                                    <% buddies.forEach((b) => { %>
                                                        <%- include('co', {rate: b.win_rate, user_id: b.user_id, user_name: b.user_name, user_sex: b.user_sex, user_pic: b.user_pic}); %>
                                                    <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="tab-pane fade<%= active_tab === 'worst' ? ' show active' : '' %>" id="worst-tab-pane" role="tabpanel" aria-labelledby="worst-tab" tabindex="0">
                                            <div class="p-2">
                                                <table class="table no-selection">
                                                    <tbody>
                                                    <% worst_opponents.forEach((o) => { %>
                                                        <%- include('co', {lose_rate: o.lose_rate, user_id: o.user_id, user_name: o.user_name, user_sex: o.user_sex, user_pic: o.user_pic}); %>
                                                    <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="tab-pane fade<%= active_tab === 'matches' ? ' show active' : '' %>" id="matches-tab-pane" role="tabpanel" aria-labelledby="matches-tab" tabindex="0">
                                            <!-- id отличается от страничного #match-history-block: периодический
                                                 рефреш $(‘#match-history-block’).load(...) затрагивает все элементы
                                                 с этим id и затирал бы фильтр по игроку всеми матчами турнира -->
                                            <div id="player-match-history-block" class="row justify-content-center mx-auto">
                                                <% user_matches.forEach((m, i) => { %>
                                                    <%- include('../../match', {index: i, match: m, total: user_matches.length}); %>
                                                <% }) %>
                                            </div>
                                            <% if (type_matches.length) { %>
                                            <% // свёрнутые матчи турниров того же типа (#57): одна строка на матч %>
                                            <div class="mt-3">
                                                <a class="link-dark link-underline-opacity-0" data-bs-toggle="collapse" href="#player-same-type-matches" role="button" aria-expanded="false" aria-controls="player-same-type-matches">
                                                    <i class="bi bi-chevron-down"></i> Остальные матчи (<%= type_matches.length %>)
                                                </a>
                                                <div class="collapse<%= expand_all ? ' show' : '' %>" id="player-same-type-matches">
                                                    <% // компактная таблица: подпись турнира (#id тип город дата),
                                                       // пара игрока первой (её счёт первым), имя игрока жирным,
                                                       // игроки в стандартном формате и кликабельны (открывают карточку),
                                                       // пары идут колонками: пара игрока (игрок, под ним
                                                       // партнёр), затем пара соперников; подпись/счёт/дельта
                                                       // объединены rowspan'ом на 2 строки; первая колонка —
                                                       // слева, остальные — по центру; шрифты — как в таблицах
                                                       // матчей (match-history-*),
                                                       // дельта рейтинга игрока с цветом, дробная часть — без хвостовых нулей %>
                                                    <% const playerHtml = (uid, name, sex, pic) =>
                                                        (uid === user.id ? '<strong>' : '') +
                                                        `<span class="co-player" data-user-id="${uid}" role="button">` +
                                                        playerNameFormatter(uid, name, sex, pic) + '</span>' +
                                                        (uid === user.id ? '</strong>' : ''); %>
                                                    <% if (is_mobile) { %>
                                                    <table class="table table-sm no-selection mb-0 same-type-mobile">
                                                        <tbody>
                                                        <% type_matches.forEach((m) => {
                                                            // пара игрока показывается первой: счёт блока — её часть
                                                            // общего счёта, дельта — в блоке пары с игроком карточки
                                                            const mine_first = m.user_1_id === user.id || m.user_2_id === user.id;
                                                            const scoreA = mine_first ? m.wins1 : m.wins2;
                                                            const scoreB = mine_first ? m.wins2 : m.wins1;
                                                            const deltaA = mine_first ? m.delta : null;
                                                            const deltaB = mine_first ? null : m.delta;
                                                            const pairA = mine_first
                                                                ? [[m.user_1_id, m.name1, m.sex1, m.pic1], [m.user_2_id, m.name2, m.sex2, m.pic2]]
                                                                : [[m.user_3_id, m.name3, m.sex3, m.pic3], [m.user_4_id, m.name4, m.sex4, m.pic4]];
                                                            const pairB = mine_first
                                                                ? [[m.user_3_id, m.name3, m.sex3, m.pic3], [m.user_4_id, m.name4, m.sex4, m.pic4]]
                                                                : [[m.user_1_id, m.name1, m.sex1, m.pic1], [m.user_2_id, m.name2, m.sex2, m.pic2]]; %>
                                                            <tr class="same-type-tournament">
                                                                <td colspan="3" class="same-type-tournament-cell"><%- include('../../tournament-label', {id: m.tournament_id, type_name: m.tournament_type_name, city: m.tournament_city, date: m.match_created_at}).trim() %></td>
                                                            </tr>
                                                            <tr>
                                                                <td class="same-type-name"><%- playerHtml(...pairA[0]) %></td>
                                                                <td rowspan="2" class="same-type-score"><span class="rating-<%= scoreA > scoreB ? 'plus' : 'minus' %> fw-bold"><%= scoreA %></span></td>
                                                                <td rowspan="2" class="same-type-delta"><%- include('../../rating-label', {v: deltaA, delta: true}).trim() %></td>
                                                            </tr>
                                                            <tr>
                                                                <td class="same-type-name"><%- playerHtml(...pairA[1]) %></td>
                                                            </tr>
                                                            <tr class="same-type-divider">
                                                                <td class="same-type-name"><%- playerHtml(...pairB[0]) %></td>
                                                                <td rowspan="2" class="same-type-score"><span class="rating-<%= scoreB > scoreA ? 'plus' : 'minus' %> fw-bold"><%= scoreB %></span></td>
                                                                <td rowspan="2" class="same-type-delta"><%- include('../../rating-label', {v: deltaB, delta: true}).trim() %></td>
                                                            </tr>
                                                            <tr>
                                                                <td class="same-type-name"><%- playerHtml(...pairB[1]) %></td>
                                                            </tr>
                                                        <% }) %>
                                                        </tbody>
                                                    </table>
                                                    <% } else { %>
                                                        <tbody>
                                                        <% type_matches.forEach((m) => { %>
                                                            <% // пара игрока показывается первой, её счёт — первым числом %>
                                                            <% const mine_first = m.user_1_id === user.id || m.user_2_id === user.id;
                                                               const mine_wins = mine_first ? m.wins1 : m.wins2;
                                                               const their_wins = mine_first ? m.wins2 : m.wins1;
                                                               const pairA = mine_first
                                                                   ? [[m.user_1_id, m.name1, m.sex1, m.pic1], [m.user_2_id, m.name2, m.sex2, m.pic2]]
                                                                   : [[m.user_3_id, m.name3, m.sex3, m.pic3], [m.user_4_id, m.name4, m.sex4, m.pic4]];
                                                               const pairB = mine_first
                                                                   ? [[m.user_3_id, m.name3, m.sex3, m.pic3], [m.user_4_id, m.name4, m.sex4, m.pic4]]
                                                                   : [[m.user_1_id, m.name1, m.sex1, m.pic1], [m.user_2_id, m.name2, m.sex2, m.pic2]]; %>
                                                            <tr>
                                                                <td rowspan="2" class="match-history-info"><%- include('../../tournament-label', {id: m.tournament_id, type_name: m.tournament_type_name, city: m.tournament_city, date: m.match_created_at}).trim() %></td>
                                                                <td class="text-center match-history-players-name"><%- playerHtml(...pairA[0]) %></td>
                                                                <td rowspan="2" class="text-center match-history-score"><span class="rating-<%= mine_wins > their_wins ? 'plus' : 'minus' %> fw-bold"><%= mine_wins %>:<%= their_wins %></span></td>
                                                                <td class="text-center match-history-players-name"><%- playerHtml(...pairB[0]) %></td>
                                                                <td rowspan="2" class="text-center match-history-delta-col"><%- include('../../rating-label', {v: m.delta, delta: true}).trim() %></td>
                                                            </tr>
                                                            <tr>
                                                                <td class="text-center match-history-players-name"><%- playerHtml(...pairA[1]) %></td>
                                                                <td class="text-center match-history-players-name"><%- playerHtml(...pairB[1]) %></td>
                                                            </tr>
                                                        <% }) %>
                                                        </tbody>
                                                    </table>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <% } %>
