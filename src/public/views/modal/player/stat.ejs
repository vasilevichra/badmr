<% // мини-плитка метрики — самостоятельная плитка bento-сетки;
   // значение «за всё время» идёт после слэша; если строка
   // не умещается — flex-wrap переносит её целиком на строку ниже;
   // параметры: cap — заголовок, val — значение, sub — значение «за всё время»
   // (пустая строка — слэш не рендерится), val_class — класс значения,
   // cls — дополнительный класс плитки (ширина в bento-сетке) %>
<div class="pw-tile pw-stat<%= cls ? ' ' + cls : '' %>">
    <div class="pw-stat-cap"><%= cap %></div>
    <div class="pw-stat-val<%= val_class ? ' ' + val_class : '' %>"><span class="pw-stat-main"><%- val %></span><% if (sub !== '') { %><span class="pw-stat-sub">/ <%- sub %></span><% } %></div>
</div>
