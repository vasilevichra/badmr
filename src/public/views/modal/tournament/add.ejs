<div id="tournament-add" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавить турнир</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form class="form-horizontal">
                    <section class="mb-2">
                        <div class="form-group text-end">
                            <div class="col">
                                <div class="input-group">
                                    <div class="form-floating">
                                        <select id="tournament-add-select-club" name="club" class="select2 form-control" required></select>
                                        <label class="control-label">Клуб <span class="text-danger">*</span></label>
                                    </div>
                                    <div class="form-floating">
                                        <select id="tournament-add-select-gym" name="gym" class="select2 form-control" disabled required></select>
                                        <label class="control-label">Зал <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="mb-2">
                        <div class="form-group text-end">
                            <div class="col">
                                <div class="input-group">
                                    <div class="form-floating">
                                        <select id="tournament-add-select-type" name="type" class="select2 form-control" required></select>
                                        <label class="control-label">Тип <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="mb-2">
                        <div class="form-group">
                            <div class="col">
                                <div class="input-group">
                                    <div class="form-floating">
                                        <input name="name" class="form-control" type="text" placeholder="Самый захватывающий турнир" required/>
                                        <label class="control-label">Название <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="mb-2">
                        <div class="form-group">
                            <div class="col">
                                <div class="input-group">
                                    <div class="form-floating">
                                        <input name="reg" class="form-control" type="datetime-local" placeholder="Окончание регистрации" required/>
                                        <label class="control-label">Окончание регистрации <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="mb-2">
                        <div class="form-group">
                            <div class="col">
                                <div class="input-group">
                                    <div class="form-floating">
                                        <input name="start" class="form-control" type="datetime-local" placeholder="Начало" required/>
                                        <label class="control-label">Начало <span class="text-danger">*</span></label>
                                    </div>
                                    <div class="form-floating">
                                        <input name="end" class="form-control" type="datetime-local" placeholder="Окончание"/>
                                        <label class="control-label">Окончание</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="mb-2">
                        <div class="form-group">
                            <div class="col">
                                <div class="input-group">
                                    <div class="form-floating">
                                        <input type="number" name="cap" class="form-control" value="20" placeholder="<%= defaults.capacity %>" required/>
                                        <label>Участников <span class="text-danger">*</span></label>
                                    </div>
                                    <div class="form-floating">
                                        <input type="number" name="courts" class="form-control" value="<%= defaults.courts %>" required/>
                                        <label>Кортов <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="mb-2">
                        <div class="form-group text-end">
                            <div class="col">
                                <div class="input-group">
                                    <div class="form-floating">
                                        <input type="number" name="rmin" class="form-control" value="<%= defaults.r_min %>">
                                        <label class="control-label">Мин. рейтинг</label>
                                    </div>
                                    <div class="form-floating">
                                        <input type="number" name="rmax" class="form-control" value="<%= defaults.r_max %>">
                                        <label class="control-label">Макс. рейтинг</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section class="mb-2">
                        <div class="form-group">
                            <div class="col">
                                <div class="input-group">
                                    <div class="form-floating">
                                        <input name="rules" class="form-control" type="url" placeholder="https://..."/>
                                        <label class="control-label">Ссылка на положение</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                    <section>
                        <div class="form-group form-check form-switch">
                            <input type="hidden" name="user" value="">
                            <label class="control-label form-check-label" for="cur">Сделать турнир текущим</label>
                            <input class="form-control form-check-input" type="checkbox" id="cur" name="cur" checked>
                        </div>
                    </section>
                    <div class="modal-footer">
                        <button type="reset" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="submit" class="btn btn-primary">Добавить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>