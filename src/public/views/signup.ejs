<% if (kind === 'page') { %>
<!doctype html>
<html lang="ru">
<head>
    <%- include('theme'); %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
    <title>Регистрация — Бадминтон и ром</title>
    <link rel="stylesheet" type="text/css" href="/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="/css/auth.css">
</head>
<body class="<%= device %>">
<div class="auth-stage">
    <section class="auth-sheet">
        <h1 class="auth-tabs"><a class="tab" href="/api/auth/login">Вход</a><span class="tab on" aria-current="page">Регистрация</span></h1>
        <p class="auth-links">Скоро: регистрация откроется позже.</p>
        <% if (vkEnabled) { %>
            <a class="btn-vk" href="/api/auth/vk">Войти через VK</a>
        <% } %>
        <p class="auth-links"><a href="/">Главная</a> <span class="dot">·</span> <span class="social"><%- include('social'); %></span></p>
    </section>
    <% if (device !== 'phone') { %><%- include('footer', { device: device }); %><% } %>
</div>
</body>
</html>
<% } %>

<% if (kind === 'modal') { %>
   <%- include('modal/player/add'); %>
<% } %>
