<% var group_index = index + 1; %>
<% var group_name = Object.values(Object.values(group)[0])[0][0]['group_name']; %>
<% var teams_in_group = Object.values(Object.values(group)[0]); %>

<div class="row text-center pt-4">
    <h3><%= group_name %></h3>
</div>

<div class="row justify-content-sm-center">
    <% teams_in_group.forEach((tg, team_index) => { %>
        <div class="col-auto">
            <div class="text-center">
                <% var team_id = tg[0].team_id; %>
                <% var team_name = tg[0].team_name; %>
                <%- include('../../modal/group/team/edit', {team_id: team_id, team_name: team_name }); %>
                <label><%= tg[0].team_city %> - <%= tg[0].team_name %></label>
                <% if (user) { %>
                    <i class="bi bi-gear" onclick="editTeam(<%= team_id %>, '<%= team_name %>')"></i>
                <% } %>
            </div>
            <div class="d-flex">
                <div class="vr tournament-groups-team-vr" style="width: 10px; color: #<%= tg[0].team_color %> !important; margin-bottom: 1em !important; opacity: 0.7 !important;"><span class="vr-seed"><%= team_index + 1 %></span></div>
                <table class="table tournament-groups-team">
                    <tbody>
                    <% tg.forEach(t => { %>
                        <tr>
                            <td><%- playerNameFormatter(t.user_id, `${t.user_lastname} ${t.user_firstname}`, t.user_sex, t.user_pic) %></td>
                            <td style="text-align: center; align-content: center">
                                <% /* клик по рейтингам открывает профиль игрока в лабе;
                                      без привязки к user_lab — просто текст */ %>
                                <% if (t.user_lab_site_id) { %><a class="lab-profile" href="https://badminton4u.ru/players/<%= t.user_lab_site_id %>" target="_blank" rel="noopener" title="Профиль в лаб"><% } %>
                                <math class="secondary-info">
                                    <% if (t.user_lab_rating_1 || t.user_lab_rating_2) { %>
                                        <% if (t.user_lab_rating_1) { %>
                                            <msub>
                                                <mi><%= t.user_lab_rating_1 %></mi>
                                                <mi>1</mi>
                                            </msub>
                                        <% } %>
                                        <% if (t.user_lab_rating_1 && t.user_lab_rating_2) { %>
                                            <mspace width="3px"/>
                                        <% } %>
                                        <% if (t.user_lab_rating_2) { %>
                                            <msub>
                                                <mi><%= t.user_lab_rating_2 %></mi>
                                                <mi>2</mi>
                                            </msub>
                                        <% } %>
                                    <% } else  { %>
                                        <mrow>
                                            <mo>-</mo>
                                        </mrow>
                                    <% } %>
                                </math>
                                <% if (t.user_lab_site_id) { %></a><% } %>
                            </td>
                            <td class="team-group-name"
                            <% if (user) { %>
                                onclick="editGroupUser(this, <%= t.team_id %>, <%= t.user_id %>, <%= t.user_group_id %>, '<%= t.user_group_name %>')"
                                    <% } %>
                            ><%= t.user_group_name %></td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% }) %>
</div>

<div class="row justify-content-sm-center">
    <div class="col-auto">
        <div class="d-flex">
            <% /* Порядок матрицы инвертирован относительно силы команд (слабейшая
                  первой): пары на антидиагонали — сеяный k против сеяного n+1-k,
                  к главной диагонали пары выравниваются по силе */ %>
            <% var matrix_teams = [...teams_in_group].reverse(); %>
            <table class="table tournament-groups-table-games">
                <tbody>
                <% /* Шапка: пустой угол + названия колонок — rowspan-ячейки, смёрженные
                      с шапкой и строками до диагонали (rowspan = j+1), диагональные
                      ячейки не рисуются. Первая команда (i=0) отдельной строкой
                      не выводится — в её строке нет ни одного матча.
                      Последнюю колонку не рисуем. */ %>
                <% var tournamentRunning = tournament.tournament_status_id === 2
                    && Date.now() >= new Date(tournament.started_at + 'Z').getTime()
                    && (!tournament.ended_at || Date.now() <= new Date(tournament.ended_at + 'Z').getTime()); %>
                <tr>
                    <td style="background-color: rgba(0, 0, 0, 0.0) !important;"></td>
                    <% var first_team = matrix_teams[0][0]; %>
                    <td class="vertical-text"><%= `${first_team.team_city} - ${first_team.team_name}` %><%-
                        include('team-rest', {team_id: first_team.team_id, total_games: teams_in_group.length * (teams_in_group.length - 1) / 2, tournamentRunning: tournamentRunning}); %></td>
                    <% for (let j = 1; j < matrix_teams.length - 1; j++) { %>
                        <td class="tournament-groups-table-game vertical-text game-column-name" rowspan="<%= j + 1 %>"><%= `${matrix_teams[j][0].team_city} - ${matrix_teams[j][0].team_name}` %><%-
                            include('team-rest', {team_id: matrix_teams[j][0].team_id, total_games: teams_in_group.length * (teams_in_group.length - 1) / 2, tournamentRunning: tournamentRunning}); %></td>
                    <% } %>
                </tr>
                <% matrix_teams.forEach((gig, i) => { %>
                    <% if (i === 0) { %>
                        <% return; %>
                    <% } %>
                    <% var team_name = `${gig[0].team_city} - ${gig[0].team_name}`; %>
                    <tr>
                        <td style="text-align: right;">
                            <%= team_name %>
                            <% /* отдых — только у идущего турнира (условие в партиале) */ %>
                            <%- include('team-rest', {team_id: gig[0].team_id, total_games: teams_in_group.length * (teams_in_group.length - 1) / 2, tournamentRunning: tournamentRunning}); %>
                        </td>
                        <% for (let j = 0; j < matrix_teams.length - 1; j++) { %>
                            <% if (i > j) { %>
                                    <% var team_name_1 = `${matrix_teams[i][0].team_city} - ${matrix_teams[i][0].team_name}`; %>
                                    <% var team_name_2 = `${matrix_teams[j][0].team_city} - ${matrix_teams[j][0].team_name}`; %>
                                    <% var team_1_id = matrix_teams[i][0].team_id; %>
                                    <% var team_2_id = matrix_teams[j][0].team_id; %>
                                    <% var game_id = `${team_1_id}-${team_2_id}`; %>
                                    <%# var game = getJson(`/api/games/current110?team_1_id=${team_1_id}&team_2_id=${team_2_id}`); %>
                                    <%- include('board', {gameId: game_id, teamIds: [team_1_id, team_2_id], teamNames: [team_name_1, team_name_2], startScores: [0, 0]}); %>

                                    <td class="tournament-groups-table-game" style="text-align: center;">
                                        <% if (user) { %>
                                            <button class="btn btn-outline-success"
                                                    type="button"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#tournament-groups-board-<%= game_id %>"
                                                    onclick="playMatch110(<%= team_1_id %>, <%= team_2_id %>)">
                                                <i class="bi bi-play fs-3"></i>
                                            </button>
                                        <% } else { %>
                                            <span>⏱️</span>
                                        <% } %>
                                    </td>
                            <% } %>
                        <% } %>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>