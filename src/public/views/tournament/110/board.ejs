<div class="modal fade" id="tournament-groups-board-<%= gameId %>" data-game-break="<%= settings.game_break %>" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <% /* плашка смены сторон: закрывает табло, пока стороны
                  не подтверждены кнопкой; показывает swapBoardSidesPlate */ %>
            <div class="board-swap-overlay" hidden>
                <div class="board-swap-plate">
                    <div class="board-swap-plate-title">Смена сторон</div>
                    <button type="button" class="btn btn-primary" onclick="hideBoardSwapPlate(this)">Продолжить</button>
                </div>
            </div>
            <% /* пауза между партиями: обратный отсчёт с game_break секунд
                  после счёта, кратного 11; прерывается кнопкой; показывает
                  showBoardBreakPlate */ %>
            <div class="board-swap-overlay board-break-overlay" hidden>
                <div class="board-swap-plate">
                    <div class="board-swap-plate-title">Следующая игра через</div>
                    <div class="board-break-seconds"></div>
                    <button type="button" class="btn btn-primary" onclick="hideBoardBreakPlate(this)">Продолжить</button>
                </div>
            </div>
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                <div class="container-fluid">
                    <div class="row vh-100 text-center no-selection">
                        <div class="col">
                            <div class="row board-team-name"><%= teamNames[0] %></div>
                            <div id="board-score-l" class="row board-score" data-team-1-id="<%= teamIds[0] %>" data-team-2-id="<%= teamIds[1] %>" data-team-number="1" onclick="increaseBoardScore(this, <%= teamIds[0] %>, <%= teamIds[1] %>, 1)"><%= startScores[0] %></div>
                            <% /* аватары реальных игроков по разрядам: для текущего
                                  разряда табло показывает свою группу (МО —
                                  одиночный мужчина, МП — пара и т.д.), группы
                                  переключает JS по .board-game-type-current.
                                  Рядом по центру, прижаты к низу блока, зазор
                                  между ними — визуальный пробел (px-1) */ %>
                            <div class="row align-content-end justify-content-center board-avatars" style="height: 10vh;">
                                <% ['МО', 'ЖО', 'МП', 'ЖП', 'СП'].forEach(avatarType => { %>
                                    <div class="col-auto px-1" data-type="<%= avatarType %>" hidden>
                                        <% teamAvatars[0][avatarType].forEach(player => { %>
                                            <div class="board-player">
                                                <span class="board-player-avatar" title="<%= player.name %>"><%- playerAvatarFormatter(player.pic, player.sex) %></span>
                                                <div class="board-player-name"><%= player.name %></div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% }); %>
                            </div>
                        </div>

                        <div class="col-auto align-content-center board-game-types">
                            <% /* смена сторон: только при счёте 0:0, при первом
                                  очке прячется (lib.js); absolute — на вёрстку
                                  колонки разрядов не влияет */ %>
                            <button type="button" class="board-swap" onclick="swapBoardSides(this)" title="Сменить стороны" aria-label="Сменить стороны"><i class="bi bi-arrow-left-right"></i></button>
                            <div class="row board-game-type board-game-type-current">МО</div>
                            <div class="row board-game-type">ЖО</div>
                            <div class="row board-game-type">МП</div>
                            <div class="row board-game-type">ЖП</div>
                            <div class="row board-game-type">СП</div>

                            <div class="row board-game-type">&bull;</div>

                            <div class="row board-game-type">МО</div>
                            <div class="row board-game-type">ЖО</div>
                            <div class="row board-game-type">МП</div>
                            <div class="row board-game-type">ЖП</div>
                            <div class="row board-game-type">СП</div>
                        </div>

                        <div class="col">
                            <div class="row board-team-name"><%= teamNames[1] %></div>
                            <div id="board-score-r" class="row board-score" data-team-1-id="<%= teamIds[0] %>" data-team-2-id="<%= teamIds[1] %>" data-team-number="2" onclick="increaseBoardScore(this, <%= teamIds[0] %>, <%= teamIds[1] %>, 2)"><%= startScores[1] %></div>
                            <div class="row align-content-end justify-content-center board-avatars" style="height: 10vh;">
                                <% ['МО', 'ЖО', 'МП', 'ЖП', 'СП'].forEach(avatarType => { %>
                                    <div class="col-auto px-1" data-type="<%= avatarType %>" hidden>
                                        <% teamAvatars[1][avatarType].forEach(player => { %>
                                            <div class="board-player">
                                                <span class="board-player-avatar" title="<%= player.name %>"><%- playerAvatarFormatter(player.pic, player.sex) %></span>
                                                <div class="board-player-name"><%= player.name %></div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>