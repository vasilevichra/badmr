<div id="tournament-groups" class="tournament-groups">
    <div class="container">
        <% if (user) { %>
            <div class="row">
                <h1 class="text-center">Группы</h1>
            </div>
        <% } %>
        <div class="row">
            <% if (user) { %>
                <div class="col d-flex">
                    <button type="button" class="btn btn-outline-primary mx-auto" data-bs-toggle="modal" data-bs-target="#tournament-groups-team-add">
                        + команда
                    </button>
                </div>
            <% } %>
            <%- include('../../modal/group/team/add', {}); %>
        </div>
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 desc">
                <div id="tournament-groups-block">
                    <% groups.forEach((g, i) => { %>
                        <%- include('group', {index: i, group: g, user: user, teamRests: teamRests}); %>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<% if (user) { %>
<div class="container">
    <div class="row"><i class="toggler bi bi-chevron-down" onclick="toggler.toggle(this)" role="button" tabindex="0" aria-label="Свернуть или развернуть блок"></i></div>
    <div id="settings" class="settings closable">
        <h1 class="text-center no-selection">Настройки</h1>
        <table id="settings-table" class="mx-auto w-auto"></table>
    </div>
    <hr class="hr-dashed"/>
</div>
<% } %>