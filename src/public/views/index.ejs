<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width,
                 initial-scale=1,
                 shrink-to-fit=no">
    <title>Бадминтон и ром</title>
    <meta name="csrf-token" content="<%= csrfToken %>">

    <link rel="icon" type="image/png" href="/assets/icons/favicon.png"/>
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-favicon.png"/>
    <link rel="stylesheet" type="text/css" href="/css/bootstrap.min.css"/>
    <link rel="stylesheet" type="text/css" href="/css/bootstrap-grid.min.css"/>
    <link rel="stylesheet" type="text/css" href="/css/bootstrap-icons.min.css"/>
    <link rel="stylesheet" type="text/css" href="/css/bootstrap-reboot.min.css"/>
    <link rel="stylesheet" type="text/css" href="/css/bootstrap-table.min.css"/>
    <link rel="stylesheet" type="text/css" href="/css/bootstrap-utilities.min.css"/>
    <link rel="stylesheet" type="text/css" href="/css/select2.min.css"/>
    <link rel="stylesheet" type="text/css" href="/css/select2-bootstrap-5-theme.css"/>
    <link rel="stylesheet" type="text/css" href="/css/index.css"/>
    <% if (user) { %>
        <link rel="stylesheet" type="text/css" href="/css/loggedin.css">
    <% } %>
</head>

<body>
<div class="container">
    <% if (user) { %>
        <div class="row"><i class="toggler bi bi-chevron-down" onclick="toggler.toggle(this)" role="button" tabindex="0" aria-label="Свернуть или развернуть блок"></i></div>
    <% } %>
    <div id="header" class="row align-items-center no-selection <% if (user) { %> closable <% } %>">
        <% if (device !== 'phone') { %>
            <div class="col-2 d-flex">
                <div class="social">
                    <%- include('social', {device: device}); %>
                </div>
            </div>
        <% } %>
        <div class="<% if (device !== 'phone') { %>col-10<% } else { %>col-12<% } %> d-flex justify-content-end">
            <% if (user) { %>
                <form action="/api/auth/logout" method="post" class="logout">
                    <% if (device !== 'phone') { %>
                        <div class="player-selectors">
                            <%- include('tournament', {tournaments: tournaments}); %>
                            <%- include('unit', {units: units}); %>
                        </div>
                    <% } %>
                    <label class="user"><%= user.username %></label>
                    <button class="btn<% if (device === 'phone') { %> me-2<% } %>" type="submit"><p class="bi bi-box-arrow-right" style="display:inline"></p></button>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                </form>
            <% } else { %>
                <form action="/api/auth/login" method="get" class="login">
                    <button class="btn<% if (device === 'phone') { %> mx-2<% } %>" type="submit"><p class="bi bi-box-arrow-in-left"> Войти</p></button>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                </form>
            <% } %>
        </div>
    </div>
    <% if (user) { %>
        <hr class="hr-dashed"/>
    <% } %>
</div>

<%# просматриваемый турнир приходит из роута (/tournament/:id), иначе — текущий %>
<% const current_tournament = typeof tournament !== 'undefined' ? tournament : tournaments.filter(t => t.current === 1)[0]; %>

<div class="container">
    <div class="row"><i class="toggler bi bi-chevron-down" onclick="toggler.toggle(this)" role="button" tabindex="0" aria-label="Свернуть или развернуть блок"></i></div>
    <div id="tournament-info" class="row d-flex closable p-3">
        <% const monthArray = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря']; %>
        <% const startedAt = new Date(current_tournament.started_at + 'Z'); %>
        <% const endedAt = new Date(current_tournament.ended_at + 'Z'); %>
        <% const regEndedAt = new Date(current_tournament.reg_ended_at + 'Z'); %>
        <% const regEndH = regEndedAt.getHours(); %>
        <% const regEndM = regEndedAt.getMinutes(); %>
        <% const regEndDateStr = `${regEndedAt.getDate()} ${monthArray[regEndedAt.getMonth()]} ${regEndH <= 9 ? '0' + regEndH : regEndH}:${regEndM <= 0 ? '0' + regEndM : regEndM}`; %>
        <% const getSingleDateStrPhone = (d) => `${d.getDate()} ${monthArray[d.getMonth()].length > 4 ? monthArray[d.getMonth()].slice(0, 3) + '.' : monthArray[d.getMonth()]} ${d.getHours() <= 9 ? '0' + d.getHours() : d.getHours()}:${d.getMinutes() <= 0 ? '0' + d.getMinutes() : d.getMinutes()}`; %>
        <% const regEndUntilMillis = (regEndedAt - new Date()); %>
        <% const regEndUntilDays = Math.floor((regEndUntilMillis) / 1000 / 60 / 60 / 24); %>
        <% const regEndUntilHours = Math.floor((regEndUntilMillis - regEndUntilDays * 1000 * 60 * 60 * 24) / 1000 / 60 / 60); %>
        <% const regEndUntilMinutes = Math.floor((regEndUntilMillis - regEndUntilDays * 1000 * 60 * 60 * 24 - regEndUntilHours * 1000 * 60 * 60) / 1000 / 60); %>
        <% const regEndUntilSecs = Math.floor((regEndUntilMillis - regEndUntilDays * 1000 * 60 * 60 * 24 - regEndUntilHours * 1000 * 60 * 60 - regEndUntilMinutes * 1000 * 60) / 1000); %>
        <%# сколько прошло с окончания регистрации — считает клиент (calendarPartsSince из lib.js) %>
        <% let regEndUntilStr = '';
        if (current_tournament.tournament_status_id === 1) {
            regEndUntilStr = ` (осталось: <time datetime="${regEndUntilDays}d ${regEndUntilHours}h ${regEndUntilMinutes}m ${regEndUntilSecs}s"></time>)`;
        } else {
            // «закончилась N назад» досчитывает клиент (calendarPartsSince из lib.js):
            // серверная строка устаревает сразу после рендера
            regEndUntilStr = ` (закончилась: <time class="reg-end-since" datetime="${regEndedAt.toISOString()}">сегодня</time>)`;
        }

        const getRegEndPhoneStr = () => {
            if (current_tournament.tournament_status_id !== 1) {
                // компактный бейдж (только старшая единица) тоже заполняет клиент
                return `<time class="reg-end-since-badge" datetime="${regEndedAt.toISOString()}">сегодня</time>`;
            }
            if (regEndUntilDays > 0) {
              return `${regEndUntilDays}д`;
            }
            if (regEndUntilHours > 0) {
                return `${regEndUntilHours}ч`;
            }
            if (regEndUntilMinutes > 0) {
                return `${regEndUntilMinutes}м`;
            }
            if (regEndUntilSecs > 0) {
                return `${regEndUntilSecs}с`;
            }
            return '';
        }
        %>
        <% const durationHours = Math.trunc((endedAt - startedAt) / 36e5); %>
        <% const durationMinutesWithoutHours = Math.trunc(((endedAt - startedAt) - durationHours * 36e5) / 6e4); %>

        <% const startedH = startedAt.getHours() <= 9 ? '0' + startedAt.getHours() : startedAt.getHours(); %>
        <% const startedM = startedAt.getMinutes() <= 0 ? '0' + startedAt.getMinutes() : startedAt.getMinutes(); %>
        <% const endedH = endedAt.getHours() <= 9 ? '0' + endedAt.getHours() : endedAt.getHours(); %>
        <% const endedM = endedAt.getMinutes() <= 0 ? '0' + endedAt.getMinutes() : endedAt.getMinutes(); %>
        <% const getDateStr = () => {
            if (!current_tournament.ended_at) { // окончание турнира не задано
                return `${startedAt.getDate()} ${monthArray[startedAt.getMonth()]} ${startedAt.getFullYear()} ${startedH}:${startedM}`;
            }
            if (startedAt.getFullYear() === endedAt.getFullYear() && startedAt.getMonth() === endedAt.getMonth() && startedAt.getDate() === endedAt.getDate()) { // начало и окончание в один день
                return `${endedAt.getDate()} ${monthArray[endedAt.getMonth()]} ${endedAt.getFullYear()} ${startedH}:${startedM}-${endedH}:${endedM}`;
            }

            const startMonthNum = startedAt.getMonth() + 1;
            const startMonthNumStr = startMonthNum <= 9 ? '0' + startMonthNum : startMonthNum;
            const endMonthNum = endedAt.getMonth() + 1;
            const endMonthNumStr = endMonthNum <= 9 ? '0' + endMonthNum : endMonthNum;
            if (startedAt.getFullYear() === endedAt.getFullYear()) { // начало и окончание в одном году
                return `${startedAt.getDate()}.${startMonthNumStr} ${startedH}:${startedM} - ${endedAt.getDate()}.${endMonthNumStr}.${endedAt.getFullYear()} ${endedH}:${endedM}`;
            }

            return `${startedAt.getDate()}.${startMonthNumStr}.${startedAt.getFullYear()} ${startedH}:${startedM} - ${endedAt.getDate()}.${endMonthNumStr}.${endedAt.getFullYear()} ${endedH}:${endedM}`; // начало и окончание в разных годах
        }
        const getDateStrPhone = () => {
            if (!current_tournament.ended_at) { // окончание турнира не задано
                return `${startedAt.getDate()} ${monthArray[startedAt.getMonth()]} ${startedH}:${startedM}`;
            }
            if (startedAt.getFullYear() === endedAt.getFullYear() && startedAt.getMonth() === endedAt.getMonth() && startedAt.getDate() === endedAt.getDate()) { // начало и окончание в один день
                return `${endedAt.getDate()} ${monthArray[endedAt.getMonth()]} ${startedH}:${startedM}-${endedH}:${endedM}`;
            }

            const startMonthNum = startedAt.getMonth() + 1;
            const startMonthNumStr = startMonthNum <= 9 ? '0' + startMonthNum : startMonthNum;
            const endMonthNum = endedAt.getMonth() + 1;
            const endMonthNumStr = endMonthNum <= 9 ? '0' + endMonthNum : endMonthNum;
            if (startedAt.getFullYear() === endedAt.getFullYear()) { // начало и окончание в одном году
                return `${startedAt.getDate()}.${startMonthNumStr} ${startedH}:${startedM} - ${endedAt.getDate()}.${endMonthNumStr} ${endedH}:${endedM}`;
            }

            return `${startedAt.getDate()}.${startMonthNumStr}.${startedAt.getFullYear()} ${startedH}:${startedM} - ${endedAt.getDate()}.${endMonthNumStr}.${endedAt.getFullYear()} ${endedH}:${endedM}`; // начало и окончание в разных годах
        }
        %>
        <% const tournamentName = `Турнир: «${current_tournament.name}»` %>

        <% if (device === 'phone') { %>
            <div class="panel panel-default" style="font-size: 0.8rem;">
                <div class="panel-heading text-center"><%= tournamentName %></div>
                <div class="list-group">
                    <span class="list-group-item">Регистрация до: <%= getSingleDateStrPhone(regEndedAt) %><span class="badge bg-badmr float-start"><%- getRegEndPhoneStr() %></span></span>
                    <span class="list-group-item">Дата: <%= getDateStrPhone() %><% if (current_tournament.ended_at) { %><span class="badge bg-badmr float-start"><%= durationHours %>ч<%= durationMinutesWithoutHours > 0 ? ` ${durationMinutesWithoutHours}м` : '' %></span><% } %></span>
                    <% if (current_tournament.map_url) { %>
                        <span class="list-group-item text-center"><i class="bi bi-geo-alt"></i> <a href="<%= current_tournament.map_url %>" target="_blank" rel="noopener noreferrer"><%= current_tournament.city %>, <%= current_tournament.address %></a></span>
                    <% } else { %>
                        <span class="list-group-item text-center"><%= current_tournament.address %></span>
                    <% } %>
                    <span class="list-group-item text-center"><i class="bi bi-people"></i> <%= registered_count %>/<%= settings.capacity %> | <i class="bi bi-journal-text"></i> <%- current_tournament.rules %> | <i class="bi bi-activity"></i> <%= settings.r_min %>-<%= settings.r_max %></span>
                </div>
            </div>
        <% } else { %>
            <div class="col-6">
                <div><%= tournamentName %>
                    <button class="btn btn-xs bi-copy tournament-name-copy" data-name="<%= current_tournament.name %>" title="Скопировать название" aria-label="Скопировать название турнира"></button>
                </div>
                <div>Регистрация до: <%= regEndDateStr %><%- regEndUntilStr %></div>
                <div>Дата: <%= getDateStr() %>
                    <% if (current_tournament.ended_at) { %> (<%= durationHours %>ч<%= durationMinutesWithoutHours > 0 ? ` ${durationMinutesWithoutHours}м` : '' %>)<% } %>
                    <!--                <button class="btn btn-xs bi-calendar" onclick="addEventToCalendar();"></button>-->
                </div>
            </div>
            <div class="col-6 justify-content-end align-items-end">
                <div class="row text-start">
                    <% if (current_tournament.latitude && current_tournament.longitude) { %>
                        <div class="text-end"><%= current_tournament.latitude %>, <%= current_tournament.longitude %>
                            <button class="btn btn-xs bi-copy coords-copy" data-coords="<%= current_tournament.latitude %>, <%= current_tournament.longitude %>" title="Скопировать координаты" aria-label="Скопировать координаты"></button>
                        </div>
                    <% } %>
                </div>
                <div class="row text-start">
                    <% if (current_tournament.map_url) { %>
                        <a class="text-end" href="<%= current_tournament.map_url %>" target="_blank" rel="noopener noreferrer"><%= current_tournament.city %>, <%= current_tournament.address %></a>
                    <% } else { %>
                        <span><%= current_tournament.address %></span>
                    <% } %>
                </div>
                <% if (current_tournament.rules) { %>
                    <div class="row text-start">
                        <div class="col text-end">
                            <span class="me-1"><i class="bi bi-people"></i> <%= registered_count %>/<%= settings.capacity %></span>
                            <span class="me-1"><i class="bi bi-activity"></i> <%= settings.r_min %>-<%= settings.r_max %></span>
                            <%- current_tournament.rules %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
    <hr class="hr-dashed"/>
</div>

<div id="tournament-window">
    <% if (tournament_type === 1) { %> <%# Рейтинг %>
    <%- include('tournament/new/index', {user: user, defaults: defaults, tournament: current_tournament}); %>
    <% } else if (tournament_type === 2) { %> <%# 110 %>
    <%- include('tournament/110/index', {user: user}); %>
    <% } else { %>
        <h1 class="text-center">Неизвестный турнир</h1>
    <% } %>
</div>

